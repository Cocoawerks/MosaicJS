<!-- A drawer of the application's own: its markup here, its behaviour beside it
     in FiltersDrawerController.js, which the compiler pairs with it by name.

     A Drawer is a surface — pinned to the window and placed by the runtime — so
     like a DialogBox or a PopOver it may only be the root of a .ib.xml file. The
     page names this file and keeps an outlet on it. -->

<interface>
    <Drawer title="Filters" outlet="drawer" action="open:onOpen close:onClose">
        <div styleName="body">
            <p styleName="note">
                A drawer pushes the page aside rather than covering it: the room it
                takes is padding on the document, and what is behind reflows into
                what is left as it slides. The page stays live throughout — try the
                controls behind it.
            </p>

            <CheckBox text="Only what is unread" outlet="unreadBox" action="filterChanged"/>
            <CheckBox text="Only what is starred" outlet="starredBox" action="filterChanged"/>

            <label styleName="label" for="sort-combo">Sort by</label>
            <ComboBox controlId="sort-combo" outlet="sortCombo" action="sortChanged">
                <Option text="Newest first" value="newest"/>
                <Option text="Oldest first" value="oldest"/>
                <Option text="By sender" value="sender"/>
            </ComboBox>

            <!-- The same list again as a popup: its menu is the framework's own and
                 stands over the control, so like the well's chooser below it has to
                 clear the drawer's panel rather than be clipped by it. -->
            <label styleName="label" for="density-combo">Density</label>
            <ComboBox popup controlId="density-combo" outlet="densityCombo"
                      value="cosy" action="densityChanged">
                <Option text="Roomy" value="roomy"/>
                <Option text="Cosy" value="cosy"/>
                <Option text="Tight" value="tight"/>
            </ComboBox>

            <!-- A well in a drawer is what the drawer's sheet is written around:
                 its chooser is a popover, which stacks above the panel and is not
                 clipped by it. -->
            <label styleName="label" for="tag-well">Tag colour</label>
            <ColorWell controlId="tag-well" outlet="tagWell" color="#3584e4"
                       action="colourChanged"/>

            <Button text="Clear them" action="clear"/>
        </div>
    </Drawer>

    <style>
        .body {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .note {
            margin: 0 0 0.5rem;
            font-size: 0.85rem;
            line-height: 1.45;
            color: var(--secondary-foreground, var(--text-color));
        }

        .label {
            font-size: 0.85rem;
            color: var(--secondary-foreground, var(--text-color));
        }
    </style>
</interface>
