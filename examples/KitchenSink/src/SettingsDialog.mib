<!-- A dialog of the application's own: its markup here, its behaviour beside it
     in SettingsDialogController.js, which the compiler pairs with it by name.
     The page names it as a tag and keeps an outlet on it; what that outlet
     hands over is this controller.

     A child that names no slot is the dialog's content; the buttons that settle
     it say slot="footer". The primary one is what Enter presses. -->
<DialogBox title="Settings" outlet="dialog" pack="true">
    <div styleName="body">
        <p styleName="note">
            A native dialog: modal, so the page behind it is shut out until it is
            answered. Escape and the X in the header both close it — and both are
            asked first, so a dialog with something unsaved in it can refuse.
        </p>

        <div styleName="field">
            <label styleName="label">Display name</label>
            <!-- Every keystroke, as a change: what makes the dialog dirty is
                 typing in it, not the user saying they are done. -->
            <TextField placeholder="Your name" outlet="nameField"
                       action="change:nameChanged"/>
        </div>

        <div styleName="field">
            <CheckBox outlet="warnBox" text="Ask before discarding changes"
                      value="true" action="warnChanged"/>
        </div>

        <p styleName="hint">{hint}</p>
    </div>

    <!-- The footer's own row. `intent="primary"` is what Enter presses, the way
         Return submits a form. -->
    <div slot="footer" styleName="buttons">
        <Button text="Cancel" action="cancel"/>
        <Button text="Save" intent="primary" action="save"/>
    </div>
</DialogBox>

<style>
    .body {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1rem 1.15rem;
        width: 380px;
    }

    .note {
        margin: 0;
        font-size: 0.85rem;
        line-height: 1.45;
        color: var(--secondary-foreground);
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .label {
        font-size: 0.85rem;
        color: var(--text-color);
    }

    .hint {
        margin: 0;
        min-height: 1.2em;
        font-family: ui-monospace, monospace;
        font-size: 0.8rem;
        color: var(--secondary-foreground);
    }

    .buttons {
        display: flex;
        flex-direction: row;
        justify-content: flex-end;
        gap: 0.6rem;
        margin: 15px;
    }
</style>
