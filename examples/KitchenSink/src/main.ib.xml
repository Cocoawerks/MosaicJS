        /* The two bars, framed so they read as the top of a window rather than as
           two strips loose on the page. */
        .bars {
            width: 100%;
            border: 1px solid var(--group-border-color);
            border-radius: 6px;
            overflow: hidden;
        }

        /* The save pill that sits beside the title — the kind of thing the Java
           version's `status` slot held, and what a child naming no region is for. */
        .pill {
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 0.75rem;
            background: rgba(127, 127, 127, 0.25);
            white-space: nowrap;
        }

        /* Icons for the two bars. Same mask as the menu's, over the elements a
           ToolBarItem and a TitleBarButton draw — both another module's, so this
           page reaches them with `:global` as it does the menu lines. */
        :global(.v-ToolBarItem .icon.ks-bar-icon),
        :global(.v-TitleBarButton .icon.ks-bar-icon) {
            background-color: currentColor;
            -webkit-mask-image: var(--ks-icon);
            mask-image: var(--ks-icon);
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
            -webkit-mask-position: center;
            mask-position: center;
            -webkit-mask-size: contain;
            mask-size: contain;
        }

        /* A list fills the box it is given: these are the boxes. */
        .list-frame {
            width: 100%;
            max-width: 380px;
            height: 132px;
            box-sizing: border-box;
            border: 1px solid var(--group-border-color);
            border-radius: 6px;
            background: var(--light-view-background);
            overflow: hidden;
        }

        .tall {
            height: 200px;
        }

        .values {
            margin: 1rem 0 0;
            font-family: ui-monospace, monospace;
            font-size: 0.8rem;
            color: var(--secondary-foreground);
        }

        .last {
            margin: 0;
            padding: 0.6rem 0.75rem;
            border-radius: 6px;
            background: var(--dark-view-background);
            font-size: 0.85rem;
        }
	
