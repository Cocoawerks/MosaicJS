<!-- Composite: one view composed into three places.

     StatCard.ib.xml and Reading.ib.xml are views of the application's own. Neither is
     a class extending Component — a `.ib.xml` file is enough, and its file name is
     the tag that places it. What the tag says is what the view holds.

     The same two files appear here in the page, inside a dialog, and inside a
     popover. A view does not know which it is in. -->

<interface>
    <div styleName="page">
        <header styleName="bar">
            <h1 styleName="title">{title}</h1>
            <span styleName="spacer"></span>

            <label styleName="label" for="theme-combo">Theme</label>
            <ComboBox controlId="theme-combo" outlet="themeCombo" action="themeChanged">
                <Option text="Aristo" value="aristo"/>
                <Option text="Aristo Dark" value="aristo_dark"/>
                <Option text="Pop" value="pop"/>
            </ComboBox>
        </header>

        <section styleName="section">
            <h2 styleName="heading">In a view</h2>
            <p styleName="note">
                Three StatCards, one file, three sets of attributes. StatCard.ib.xml
                has no class and no controller beside it — the file is the whole of
                it. The third carries an outlet, so the page can read and write what
                it holds: a prop is ordinary state, whether it arrived on the tag or
                was assigned afterwards.
            </p>

            <div styleName="cards">
                <StatCard label="Sessions" value="1,204" note="this week"/>
                <StatCard label="Errors" value="3" note="since the deploy"/>

                <!-- An outlet on a view with no class of any kind still hands the
                     page something to talk to: the view's own scope, carrying what
                     this tag gave it. The buttons below read and write it. -->
                <StatCard label="Queue" value="0" note="nothing waiting"
                          outlet="queueCard"/>
            </div>

            <div styleName="row">
                <Button text="Add to the queue" action="addToQueue"/>
                <Button text="Empty it" action="emptyQueue"/>
            </div>

            <h2 styleName="heading">A view with a controller of its own</h2>
            <p styleName="note">
                Reading.ib.xml is paired with ReadingController.js by name, so it draws
                against a fresh instance of that controller. The tag's attributes
                reach it — `celsius` below is what it works the reading out from —
                and pressing °F makes the same view say it the other way.
            </p>
            <p styleName="note">
                An outlet on a view that has a controller hands that controller
                over, which is how the page says something to it afterwards: the
                button below assigns `celsius` again, and the view follows.
            </p>

            <div styleName="row">
                <Reading place="Reykjavík" celsius="4.5" outlet="reykjavik"/>
                <Reading place="Kraków" celsius="18.2"/>
            </div>

            <div styleName="row">
                <Button text="A degree warmer" outlet="warmerButton" action="warmer"/>
                <Button text="Put it back" action="resetReading"/>
            </div>
        </section>

        <section styleName="section">
            <h2 styleName="heading">In a dialog, and in a popover</h2>
            <p styleName="note">
                A Dialog and a PopOver can only be the root of a .ib.xml file of
                their own — they are placed by the runtime rather than by the markup
                around them, so nesting one here would read as something this page
                does not do. Each is its own file, named below.
            </p>

            <div styleName="row">
                <Button text="Show the summary…" outlet="summaryButton" action="showSummary"/>
                <Button text="Detail…" outlet="detailButton" action="showDetail"/>
            </div>

            <SummaryDialog outlet="summary"/>
            <DetailPopOver outlet="detail"/>
        </section>

        <p styleName="status">{note}</p>
    </div>

    <style>
        :global(body) {
            margin: 0;
            font-family: var(--font-family);
            color: var(--text-color);
            background: var(--view-background);
        }

        .page {
            max-width: 52rem;
            margin: 0 auto;
            padding-bottom: 2rem;
        }

        .bar {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.7rem 1rem;
            border-bottom: 1px solid var(--default-border-color);
            background: var(--light-view-background);
        }

        .title {
            margin: 0;
            font-size: 1.05rem;
        }

        .spacer {
            flex: 1;
        }

        .label {
            font-size: 0.85rem;
            color: var(--secondary-foreground, var(--text-color));
        }

        .section {
            padding: 1rem;
        }

        .heading {
            margin: 1.2rem 0 0.4rem;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--secondary-foreground, var(--text-color));
        }

        .note {
            margin: 0 0 0.8rem;
            font-size: 0.9rem;
            line-height: 1.5;
            max-width: 44rem;
        }

        .cards,
        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            align-items: center;
            margin-bottom: 0.8rem;
        }

        .status {
            margin: 0;
            padding: 0.5rem 1rem;
            border-top: 1px solid var(--default-border-color);
            background: var(--light-view-background);
            font-family: ui-monospace, monospace;
            font-size: 0.8rem;
            color: var(--secondary-foreground, var(--text-color));
        }
    </style>
</interface>
