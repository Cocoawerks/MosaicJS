<!-- A dialog whose content is composed views. A Dialog may only be the root
     of a .ib.xml file — nested in other markup it would draw in that markup's
     flow, which is not where a dialog goes — so this is the file it is the root
     of, and the page places it by name: <SummaryDialog outlet="…"/>.

     Everything below is StatCard.ib.xml and Reading.ib.xml, the same two files the
     page composes. A view does not know what it has been composed into. -->

<interface>
    <Dialog title="This week" outlet="dialog" pack="true">
        <div styleName="body">
            <p styleName="note">
                These are the same two views the page behind this dialog uses, given
                different attributes. Nothing here knows it is in a dialog.
            </p>

            <div styleName="cards">
                <StatCard label="Sessions" value="1,204" note="this week"/>
                <StatCard label="Errors" value="3" note="since the deploy"/>
                <StatCard label="Uptime" value="99.9%" note="rolling 30 days"/>
            </div>

            <!-- A view with a controller of its own: its outlet hands that
                 controller over, so this dialog can say something to it later. -->
            <Reading place="Reykjavík" celsius="4.5" outlet="reading"/>
        </div>

        <div slot="footer" styleName="buttons">
            <Button text="Close" action="close"/>
            <Button text="A degree warmer" intent="primary" action="warmer"/>
        </div>
    </Dialog>

    <style>
        .body {
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
            padding: 1rem 1.15rem;
            width: 30rem;
        }

        .note {
            margin: 0;
            font-size: 0.85rem;
            line-height: 1.45;
            color: var(--secondary-foreground, var(--text-color));
        }

        .cards {
            display: flex;
            gap: 0.6rem;
        }

        .buttons {
            display: flex;
            justify-content: flex-end;
            gap: 0.6rem;
            margin: 15px;
        }
    </style>
</interface>
