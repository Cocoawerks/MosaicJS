<!-- And a popover, under the same rule: a PopOver may only be the root of a
     .mib file, so this is that file and the page names it — <DetailPopOver/>.

     Its content is composed views too, so all three surfaces in this
     application — the page, the dialog and this — are built from the same two
     files. -->

<PopOver orientation="bottom_center" outlet="popover">
    <div styleName="body">
        <h3 styleName="heading">Queue detail</h3>

        <StatCard label="Waiting" value="12" note="oldest 4m ago"/>
        <Reading place="Kraków" celsius="18.2" outlet="reading"/>
    </div>
</PopOver>

<style>
    .body {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0.4rem;
        max-width: 18rem;
    }

    .heading {
        margin: 0;
        font-size: 0.95rem;
        color: var(--text-color);
    }
</style>
