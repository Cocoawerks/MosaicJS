<!-- Files — reading and writing files, which is FileReader and FileWriter and
     nothing else. A notepad is the smallest thing that needs both.

     There is no file-picking component here and there is not meant to be: a
     browser opens a chooser only for a real click on a real input, so the file
     module keeps one hidden and clicks it. What the page shows is buttons. -->

<interface>
    <div styleName="app">
        <h1 styleName="title">{MESSAGES.Files}</h1>

        <div styleName="bar">
            <Button text="{MESSAGES.Open…}" action="open"/>
            <Button text="{MESSAGES.Open picture…}" action="openImage"/>
            <TextField outlet="nameField" placeholder="untitled.txt"/>
            <Button text="{MESSAGES.Save…}" intent="primary" action="save"/>
        </div>

        <textarea styleName="editor" outlet="editor" spellcheck="false"
                  placeholder="{MESSAGES.Open a file, or type something and save it.}"
                  action="input:edited"></textarea>

        <p styleName="status">{status}</p>

        <!-- The picture, when one has been opened. Read as a data: URL, it goes
             straight into an <img> — which is what that mode is for. -->
        <div styleName="preview {previewState}">
            <img styleName="picture" src="{image}" alt="The picture that was opened"/>
            <Button text="{MESSAGES.Close picture}" action="clearImage"/>
        </div>
    </div>

    <style>
        .app {
            font-family: system-ui, sans-serif;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            max-width: 40rem;
        }

        .title {
            font-size: 1.25rem;
            margin: 0;
        }

        .bar {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .editor {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.8rem;
            line-height: 1.5;
            min-height: 14rem;
            padding: 0.6rem 0.8rem;
            border: 1px solid var(--field-border-color);
            border-radius: 4px;
            resize: vertical;
        }

        .status {
            color: #666;
            font-size: 0.8rem;
            margin: 0;
        }

        /* The preview is out of the way until there is something in it. */
        .preview {
            display: none;
            flex-direction: column;
            gap: 0.5rem;
            align-items: flex-start;
        }

        .preview.shown {
            display: flex;
        }

        .picture {
            max-width: 100%;
            max-height: 16rem;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
        }
    </style>
</interface>
