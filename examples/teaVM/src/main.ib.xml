<interface>

    <style>
        .card {
            max-width: 360px;
            margin: 48px auto;
            padding: 24px;
            border: 1px solid #d0d0d0;
            border-radius: 10px;
            font-family: system-ui, sans-serif;
        }

        h1 {
            font-size: 18px;
            margin: 0 0 4px;
        }

        .sub {
            color: #666;
            font-size: 13px;
            margin: 0 0 20px;
        }

        .row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }

        .result {
            font-size: 28px;
            font-weight: 600;
        }

        /* The password checklist: one row per rule, ticked off as it passes. */
        .rules {
            list-style: none;
            padding: 0;
            margin: 16px 0 0;
        }

        .rule {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 0;
            font-size: 14px;
            color: #888;
            transition: color 0.15s;
        }

        .rule::before {
            content: "○";
            font-size: 15px;
            width: 16px;
            text-align: center;
        }

        .rule.ok {
            color: #1a7f37;
        }

        .rule.ok::before {
            content: "✓";
            font-weight: 700;
        }
    </style>

    <div styleName="card">
        <h1>Square feet → square metres</h1>
        <p styleName="sub">The conversion runs in Java, compiled to JavaScript by TeaVM.</p>

        <div styleName="row">
            <TextField outlet="feet" placeholder="e.g. 500" action="change:recalc"/>
            <span>ft²</span>
        </div>

        <div styleName="result">{meters}</div>
    </div>

    <div styleName="card">
        <h1>Choose a password</h1>
        <p styleName="sub">Each rule is checked in Java as you type.</p>

        <div styleName="row">
            <TextField outlet="password" type="password"
                       placeholder="Password" action="change:validate"/>
        </div>

        <ul styleName="rules">
            <li styleName="rule {lengthClass}">At least 8 characters</li>
            <li styleName="rule {upperClass}">A capital letter</li>
            <li styleName="rule {digitClass}">A number</li>
            <li styleName="rule {specialClass}">A special symbol</li>
        </ul>
    </div>

</interface>
