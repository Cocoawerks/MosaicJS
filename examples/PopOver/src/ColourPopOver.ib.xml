<!-- A popover of the application's own: markup here, behaviour in
     ColourPopOverController.js beside it, which the compiler pairs with it. -->

<interface>
    <PopOver orientation="bottom_center" outlet="popover">
        <div styleName="body">
            <h3 styleName="heading">{heading}</h3>
            <Button text="Red" action="pick"/>
            <Button text="Green" action="pick"/>
            <p styleName="chosen">chosen: {chosen}</p>
        </div>
    </PopOver>

    <style>
        .body {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0.5rem;
            min-width: 160px;
        }

        .heading {
            margin: 0;
            font-size: 0.9rem;
            color: var(--text-color);
        }

        .chosen {
            margin: 0;
            font-size: 0.8rem;
            color: var(--secondary-foreground);
        }
    </style>
</interface>
