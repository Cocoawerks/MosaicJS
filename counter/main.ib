<!-- The application root. `<Counter/>` is examples/Counter.js, a drawn View;
     the compiler emits its import automatically. -->
<View styleName="app">
  <h1 styleName="title">{title}</h1>

  <Counter limit="3" />

  <p styleName="hint">The counter draws itself; this page is .ib markup.</p>
</View>

<style>
  .app {
    font-family: system-ui, sans-serif;
    padding: 1rem;
  }
  .title {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
  }
  .hint {
    color: #666;
    font-size: 0.8rem;
    margin-top: 0.75rem;
  }
</style>
